@{
    ViewData["Title"] = L["Auth_ForgotPassword"].Value;
}

<style>
    /* Premium Tech-SaaS Background */
    .auth-bg {
        background-color: #080b11;
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        margin-top: -48px;
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow Circles */
    .auth-glow-circle {
        position: absolute;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.25;
        z-index: 1;
        pointer-events: none;
    }
    .auth-glow-1 {
        top: 20%;
        left: 15%;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, #6366f1 0%, rgba(99, 102, 241, 0) 70%);
    }
    .auth-glow-2 {
        bottom: 15%;
        right: 15%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, #a855f7 0%, rgba(168, 85, 247, 0) 70%);
    }

    /* Interactive Mesh Grid Pattern */
    .auth-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
        background-size: 40px 40px;
        z-index: 2;
        pointer-events: none;
    }

    /* Premium Glassmorphic Card */
    .auth-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        background: rgba(15, 22, 36, 0.78);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 
                    inset 0 1px 0 rgba(255, 255, 255, 0.08);
        padding: 44px 38px;
        width: 100%;
        max-width: 480px;
        position: relative;
        z-index: 3;
    }

    .auth-icon {
        width: 68px;
        height: 68px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.22) 0%, rgba(168, 85, 247, 0.12) 100%);
        color: #818cf8;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 24px;
        border: 1px solid rgba(99, 102, 241, 0.3);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.18);
    }

    /* Input Styling */
    .form-label-custom {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 8px;
        display: block;
    }

    .form-control-custom {
        width: 100%;
        border-radius: 14px;
        padding: 14px 20px 14px 46px;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        background-color: #ffffff !important;
        color: #0f172a !important;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .form-control-custom:focus {
        background-color: #ffffff !important;
        border-color: #818cf8 !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25);
        outline: none;
    }
    .input-icon-custom {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #0f172a !important;
        font-size: 1.1rem;
        pointer-events: none;
        transition: color 0.3s ease;
        z-index: 5;
    }

    .btn-auth-premium {
        background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        border-radius: 14px;
        padding: 14px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25);
    }
    .btn-auth-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(99, 102, 241, 0.45);
        color: #ffffff;
    }

    /* ── Dream / Thought Cloud (Spam Notice) ── */
    .thought-cloud-wrapper {
        position: relative;
        margin: 22px 0 14px;
        animation: cloudPopIn 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .thought-cloud {
        position: relative;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.18) 0%, rgba(168, 85, 247, 0.22) 50%, rgba(236, 72, 153, 0.14) 100%);
        border: 1.5px solid rgba(168, 85, 247, 0.48);
        border-radius: 28px 28px 28px 10px;
        padding: 22px 24px;
        box-shadow: 0 18px 40px -8px rgba(168, 85, 247, 0.3),
                    inset 0 1px 2px rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        animation: floatCloud 4.5s ease-in-out infinite 0.7s;
        z-index: 2;
    }

    /* Subtle decorative cloud puffs on top */
    .thought-cloud::before {
        content: '';
        position: absolute;
        top: -11px;
        left: 28px;
        width: 36px;
        height: 22px;
        background: rgba(120, 110, 240, 0.22);
        border-top: 1.5px solid rgba(168, 85, 247, 0.5);
        border-left: 1.5px solid rgba(168, 85, 247, 0.5);
        border-radius: 50% 50% 0 0;
        pointer-events: none;
    }

    .thought-cloud::after {
        content: '';
        position: absolute;
        top: -18px;
        left: 56px;
        width: 48px;
        height: 30px;
        background: rgba(145, 95, 245, 0.24);
        border-top: 1.5px solid rgba(168, 85, 247, 0.5);
        border-radius: 50% 50% 0 0;
        pointer-events: none;
    }

    .thought-cloud-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .thought-cloud-emoji {
        font-size: 1.5rem;
        filter: drop-shadow(0 2px 8px rgba(168, 85, 247, 0.5));
        animation: pulseEmoji 3s ease-in-out infinite;
        display: inline-block;
        line-height: 1;
    }

    .thought-cloud-title {
        font-weight: 700;
        font-size: 1rem;
        color: #ffffff;
        letter-spacing: -0.2px;
    }

    .thought-cloud-body {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.82);
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .thought-cloud-footer {
        padding-top: 10px;
        border-top: 1px dashed rgba(168, 85, 247, 0.35);
    }

    .thought-cloud-tip-badge {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.92);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        line-height: 1.4;
    }

    /* Trailing thought circles (Dreaming aesthetic) */
    .thought-dots-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding-left: 20px;
        margin-top: 6px;
        gap: 4px;
        z-index: 1;
    }

    .thought-dot {
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.35) 0%, rgba(168, 85, 247, 0.45) 100%);
        border: 1.5px solid rgba(168, 85, 247, 0.55);
        box-shadow: 0 4px 12px rgba(168, 85, 247, 0.25);
    }

    .thought-dot-lg {
        width: 15px;
        height: 15px;
        margin-left: 8px;
    }

    .thought-dot-md {
        width: 10px;
        height: 10px;
        margin-left: 3px;
    }

    .thought-dot-sm {
        width: 6px;
        height: 6px;
        margin-left: 0;
    }

    .success-alert-card {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: #34d399;
        border-radius: 18px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .success-icon-badge {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.25);
        color: #34d399;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    @@keyframes floatCloud {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-7px);
        }
    }

    @@keyframes cloudPopIn {
        0% {
            opacity: 0;
            transform: scale(0.85) translateY(18px);
        }
        70% {
            transform: scale(1.02) translateY(-2px);
        }
        100% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes pulseEmoji {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.18) rotate(4deg); }
    }

    @@media (max-width: 575.98px) {
        .auth-bg {
            padding: 40px 16px;
        }
        .auth-card {
            padding: 32px 20px;
            border-radius: 22px;
        }
        .auth-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
            margin-bottom: 20px;
        }
    }
</style>

<div class="auth-bg">
    <div class="auth-glow-circle auth-glow-1"></div>
    <div class="auth-glow-circle auth-glow-2"></div>

    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h3 class="fw-bold mb-2" style="font-family:'Calistoga',serif; color: #ffffff; letter-spacing:-0.5px; font-size: 1.75rem;">
                @L["Auth_ForgotPassword"]
            </h3>
            <p class="mb-0" style="color: rgba(255, 255, 255, 0.6); font-size: 0.92rem">
                @L["Auth_ForgotSubtitle"]
            </p>
        </div>

        @if (ViewBag.Success != null)
        {
            <div class="success-alert-card mb-3 shadow-sm">
                <div class="success-icon-badge">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="fw-bold" style="font-size: 0.95rem; color: #ffffff;">@L["Auth_SuccessSent"]</div>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Email as string))
                    {
                        <small style="color: #6ee7b7; opacity: 0.9; display: block; margin-top: 2px;">@ViewBag.Email</small>
                    }
                </div>
            </div>

            <!-- Dream / Thought Cloud (Spam Notification) -->
            <div class="thought-cloud-wrapper">
                <div class="thought-cloud">
                    <div class="thought-cloud-header">
                        <span class="thought-cloud-emoji">💭</span>
                        <h6 class="thought-cloud-title mb-0">@L["Auth_SpamCloudTitle"]</h6>
                    </div>
                    <p class="thought-cloud-body mb-2">
                        @L["Auth_SpamCloudBody"]
                    </p>
                    <div class="thought-cloud-footer">
                        <span class="thought-cloud-tip-badge">
                            <i class="bi bi-stars text-warning"></i>
                            <span>@L["Auth_SpamCloudTip"]</span>
                        </span>
                    </div>
                </div>

                <!-- Thought trail bubbles (Dream aesthetic) -->
                <div class="thought-dots-container">
                    <div class="thought-dot thought-dot-lg"></div>
                    <div class="thought-dot thought-dot-md"></div>
                    <div class="thought-dot thought-dot-sm"></div>
                </div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger mb-4" style="border-radius: 12px; font-size: 0.9rem;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success == null)
        {
            <form method="post" action="/Auth/ForgotPassword">
                <div class="mb-4">
                    <label class="form-label-custom">@L["Auth_Email"]</label>
                    <div class="position-relative">
                        <input type="email"
                               name="email"
                               class="form-control-custom"
                               placeholder="your@email.com"
                               required
                               translate="no" />
                        <i class="bi bi-envelope input-icon-custom"></i>
                    </div>
                </div>

                <button type="submit" class="btn btn-auth-premium w-100 py-3 fw-semibold">
                    <i class="bi bi-send me-2"></i>@L["Auth_SendResetLink"]
                </button>
            </form>
        }

        <div class="text-center mt-4">
            <a asp-controller="Auth" asp-action="Login" style="color: #818cf8; font-size: 0.92rem; text-decoration: none; font-weight: 500;">
                <i class="bi bi-arrow-left me-1"></i>@L["Auth_BackToLogin"]
            </a>
        </div>
    </div>
</div>
