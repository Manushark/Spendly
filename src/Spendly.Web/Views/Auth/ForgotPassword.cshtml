@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["Auth_ForgotPassword"].Value;
}

<style>
    .auth-bg {
        background-color: var(--clr-bg);
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        margin-top: -48px;
    }
    .auth-card {
        border: 1px solid var(--clr-border);
        border-radius: 24px;
        box-shadow: var(--shadow-xl);
        background: var(--clr-bg-card);
        padding: 40px;
        width: 100%;
        max-width: 460px;
        position: relative;
    }
    .auth-icon {
        width: 64px;
        height: 64px;
        background: rgba(var(--clr-primary-rgb), 0.1);
        color: var(--clr-primary);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 24px;
        border: 1px solid rgba(var(--clr-primary-rgb), 0.2);
    }

    /* ── Dream / Thought Cloud (Spam Notice) ── */
    .thought-cloud-wrapper {
        position: relative;
        margin: 20px 0 10px;
        animation: cloudPopIn 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .thought-cloud {
        position: relative;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(168, 85, 247, 0.16) 50%, rgba(236, 72, 153, 0.1) 100%);
        border: 1.5px solid rgba(168, 85, 247, 0.4);
        border-radius: 28px 28px 28px 10px;
        padding: 20px 22px;
        box-shadow: 0 14px 35px -8px rgba(168, 85, 247, 0.25),
                    inset 0 1px 2px rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(14px);
        animation: floatCloud 4s ease-in-out infinite 0.7s;
        z-index: 2;
    }

    /* Subtle decorative cloud puffs on top */
    .thought-cloud::before {
        content: '';
        position: absolute;
        top: -10px;
        left: 28px;
        width: 34px;
        height: 20px;
        background: inherit;
        border-top: 1.5px solid rgba(168, 85, 247, 0.4);
        border-left: 1.5px solid rgba(168, 85, 247, 0.4);
        border-radius: 50% 50% 0 0;
        pointer-events: none;
    }

    .thought-cloud::after {
        content: '';
        position: absolute;
        top: -16px;
        left: 54px;
        width: 46px;
        height: 28px;
        background: inherit;
        border-top: 1.5px solid rgba(168, 85, 247, 0.4);
        border-radius: 50% 50% 0 0;
        pointer-events: none;
    }

    .thought-cloud-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .thought-cloud-emoji {
        font-size: 1.4rem;
        filter: drop-shadow(0 2px 6px rgba(168, 85, 247, 0.4));
        animation: pulseEmoji 3s ease-in-out infinite;
        display: inline-block;
    }

    .thought-cloud-title {
        font-weight: 700;
        font-size: 0.96rem;
        color: var(--clr-text);
        letter-spacing: -0.2px;
    }

    .thought-cloud-body {
        font-size: 0.86rem;
        color: var(--clr-text-muted);
        line-height: 1.48;
    }

    .thought-cloud-footer {
        padding-top: 8px;
        border-top: 1px dashed rgba(168, 85, 247, 0.3);
    }

    .thought-cloud-tip-badge {
        font-size: 0.78rem;
        color: var(--clr-text);
        display: inline-flex;
        align-items: center;
        opacity: 0.92;
        line-height: 1.4;
    }

    /* Trailing thought circles (Dreaming aesthetic) */
    .thought-dots-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding-left: 18px;
        margin-top: 4px;
        gap: 3px;
        z-index: 1;
    }

    .thought-dot {
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(168, 85, 247, 0.35) 100%);
        border: 1.5px solid rgba(168, 85, 247, 0.45);
        box-shadow: 0 4px 10px rgba(168, 85, 247, 0.2);
    }

    .thought-dot-lg {
        width: 14px;
        height: 14px;
        margin-left: 6px;
    }

    .thought-dot-md {
        width: 9px;
        height: 9px;
        margin-left: 2px;
    }

    .thought-dot-sm {
        width: 5px;
        height: 5px;
        margin-left: 0;
    }

    .success-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    @@keyframes floatCloud {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-6px);
        }
    }

    @@keyframes cloudPopIn {
        0% {
            opacity: 0;
            transform: scale(0.85) translateY(16px);
        }
        70% {
            transform: scale(1.02) translateY(-2px);
        }
        100% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes pulseEmoji {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.15) rotate(4deg); }
    }

    @@media (max-width: 575.98px) {
        .auth-bg {
            padding: 30px 14px;
        }
        .auth-card {
            padding: 32px 20px;
            border-radius: 20px;
        }
        .auth-icon {
            width: 56px;
            height: 56px;
            font-size: 24px;
            margin-bottom: 20px;
        }
    }
</style>

<div class="auth-bg">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="bi bi-envelope-lock"></i>
        </div>

        <h2 class="text-center fw-bold mb-1" style="color: var(--clr-text)">@L["Auth_ForgotPassword"]</h2>
        <p class="text-center mb-4" style="color: var(--clr-text-muted); font-size: 0.9rem">
            @L["Auth_ForgotSubtitle"]
        </p>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success rounded-4 d-flex align-items-center gap-3 p-3 shadow-sm border-0 mb-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3) !important;">
                <div class="success-icon-badge">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="fw-bold" style="font-size: 0.95rem;">@L["Auth_SuccessSent"]</div>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Email as string))
                    {
                        <small class="text-success-emphasis opacity-75 d-block mt-1">@ViewBag.Email</small>
                    }
                </div>
            </div>

            <!-- Dream / Thought Cloud (Spam Notification) -->
            <div class="thought-cloud-wrapper">
                <div class="thought-cloud">
                    <div class="thought-cloud-header">
                        <span class="thought-cloud-emoji">💭</span>
                        <h6 class="thought-cloud-title mb-0">@L["Auth_SpamCloudTitle"]</h6>
                    </div>
                    <p class="thought-cloud-body mb-2">
                        @L["Auth_SpamCloudBody"]
                    </p>
                    <div class="thought-cloud-footer">
                        <span class="thought-cloud-tip-badge">
                            <i class="bi bi-stars me-1 text-warning"></i>
                            @L["Auth_SpamCloudTip"]
                        </span>
                    </div>
                </div>

                <!-- Thought trail bubbles -->
                <div class="thought-dots-container">
                    <div class="thought-dot thought-dot-lg"></div>
                    <div class="thought-dot thought-dot-md"></div>
                    <div class="thought-dot thought-dot-sm"></div>
                </div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        @if (ViewBag.Success == null)
        {
            <form method="post" action="/Auth/ForgotPassword">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: var(--clr-text)">@L["Auth_Email"]</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: var(--clr-bg-input); border-color: var(--clr-border)">
                            <i class="bi bi-envelope" style="color: var(--clr-text-muted)"></i>
                        </span>
                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="your@email.com"
                               required
                               translate="no"
                               style="background: var(--clr-bg-input); border-color: var(--clr-border); color: var(--clr-text)" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-send me-2"></i>@L["Auth_SendResetLink"]
                </button>
            </form>
        }

        <div class="text-center mt-4">
            <a asp-controller="Auth" asp-action="Login" style="color: var(--clr-primary); font-size: 0.9rem">
                <i class="bi bi-arrow-left me-1"></i>@L["Auth_BackToLogin"]
            </a>
        </div>
    </div>
</div>
