@{
    ViewData["Title"] = "Spendly - Smart Expense Tracking";
    var token = Spendly.Web.Helpers.TokenHelper.GetToken(Context);
}

<style>
    /* ═══════════════════════════════════════════════════════════════
       SPENDLY — Premium Sleek Midnight Dark Theme
       Ajustado a un tono más claro, cálido y legible (Deep Slate #111827 / #0f172a)
       en lugar del negro carbón (#080b11), con resplandor neón e iluminación viva.
       ═══════════════════════════════════════════════════════════════ */

    body {
        background-color: #111827 !important;
        color: #F8FAFC !important;
        font-family: var(--font-body);
        overflow-x: hidden;
    }

    /* Navbar styling override */
    .public-navbar {
        background: rgba(17, 24, 39, 0.85) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }
    .public-navbar .navbar-brand {
        color: #ffffff !important;
        font-weight: 700 !important;
    }
    .public-navbar .nav-link {
        color: #cbd5e1 !important;
        font-weight: 500;
        transition: color 0.2s ease;
    }
    .public-navbar .nav-link:hover {
        color: #ffffff !important;
    }
    .public-navbar .navbar-toggler i {
        color: #ffffff !important;
    }

    /* ── Hero Section ────────────────────────────────────────── */
    .hero-section {
        position: relative;
        padding: 150px 0 110px;
        overflow: hidden;
        background: radial-gradient(circle at 85% 15%, rgba(99, 102, 241, 0.18) 0%, rgba(17, 24, 39, 0) 60%),
                    radial-gradient(circle at 15% 85%, rgba(16, 185, 129, 0.12) 0%, rgba(17, 24, 39, 0) 60%),
                    linear-gradient(180deg, #111827 0%, #0d131f 100%);
    }

    /* Ambient Glow Effects (iluminación ambiental viva) */
    .glow-bg {
        position: absolute;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.45;
        z-index: 1;
        pointer-events: none;
    }
    .glow-1 { top: 10%; right: 5%; width: 450px; height: 450px; background: #6366f1; }
    .glow-2 { bottom: 5%; left: -5%; width: 380px; height: 380px; background: #10b981; opacity: 0.25; }

    .hero-content {
        position: relative;
        z-index: 3;
    }

    /* Animated text gradient */
    .hero-title {
        font-family: var(--font-heading);
        font-size: 4.1rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 24px;
        background: linear-gradient(135deg, #ffffff 15%, #c7d2fe 55%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -1.5px;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #cbd5e1;
        margin-bottom: 42px;
        font-weight: 400;
        line-height: 1.68;
        max-width: 540px;
    }

    /* Smooth Floating Animation */
    @@keyframes floatingMockup {
        0% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(0.2deg); }
        100% { transform: translateY(0px) rotate(0deg); }
    }

    .hero-mockup-container {
        position: relative;
        z-index: 3;
        animation: floatingMockup 6s ease-in-out infinite;
    }
    
    .hero-mockup-shadow {
        position: relative;
        border-radius: 22px;
        box-shadow: 0 35px 70px rgba(0, 0, 0, 0.55), 
                    0 0 90px rgba(99, 102, 241, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: #1e293b;
        overflow: hidden;
    }
    .hero-mockup-shadow img {
        width: 100%;
        display: block;
        transition: transform 0.5s ease;
    }

    /* Premium Neon-Glow Buttons */
    .btn-glow-premium {
        background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
        color: #ffffff !important;
        border: none;
        border-radius: 50px;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 24px rgba(99, 102, 241, 0.35);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }
    .btn-glow-premium:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 32px rgba(99, 102, 241, 0.55);
        color: #ffffff !important;
    }

    .btn-glass-premium {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 50px;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }
    .btn-glass-premium:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        color: #ffffff !important;
        transform: translateY(-3px);
    }

    /* ── Benefits Section Glassmorphism ──────────────────────── */
    .features-section {
        padding: 115px 0;
        background-color: #0d131f;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        position: relative;
    }

    .glass-card-premium {
        background: rgba(255, 255, 255, 0.035);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 22px;
        padding: 44px 34px;
        height: 100%;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        text-align: left;
    }
    .glass-card-premium:hover {
        background: rgba(255, 255, 255, 0.065);
        border-color: rgba(99, 102, 241, 0.45);
        transform: translateY(-6px);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45), 
                    inset 0 0 25px rgba(99, 102, 241, 0.08);
    }

    .feature-icon-premium {
        width: 62px;
        height: 62px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(99, 102, 241, 0.08) 100%);
        color: #a5b4fc;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 26px;
        border: 1px solid rgba(99, 102, 241, 0.25);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.15);
    }

    .glass-card-premium h4 {
        color: #ffffff;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.35rem;
    }
    .glass-card-premium p {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.65;
    }

    /* ── CTA Banner Section ──────────────────────────────────── */
    .cta-section {
        padding: 95px 0;
        background: linear-gradient(180deg, #0d131f 0%, #111827 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .cta-card-wrapper {
        background: rgba(99, 102, 241, 0.05);
        border: 1px solid rgba(99, 102, 241, 0.25);
        border-radius: 26px;
        padding: 75px 28px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    }

    /* ── Footer ──────────────────────────────────────────────── */
    .dark-footer {
        background-color: #0b0f19;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding: 48px 0;
        color: #94a3b8;
    }
    .dark-footer h5 {
        color: #ffffff;
        font-family: var(--font-heading);
        font-weight: 700;
    }

    /* Responsive Media Queries */
    @@media (max-width: 991.98px) {
        .hero-section {
            padding: 110px 0 70px;
        }
        .hero-title {
            font-size: 3.25rem;
        }
        .hero-mockup-container {
            margin-top: 24px;
        }
    }

    @@media (max-width: 767.98px) {
        .hero-section {
            padding: 85px 0 45px;
        }
        .hero-title {
            font-size: 2.25rem;
            letter-spacing: -0.5px;
            line-height: 1.2;
            margin-bottom: 18px;
        }
        .hero-subtitle {
            font-size: 1.05rem;
            margin-bottom: 30px;
        }
        .btn-glow-premium,
        .btn-glass-premium {
            padding: 14px 28px;
            font-size: 1rem;
            width: 100%;
            justify-content: center;
        }
        .features-section {
            padding: 70px 0;
        }
        .features-section h2 {
            font-size: 1.9rem !important;
        }
        .glass-card-premium {
            padding: 32px 24px;
        }
        .cta-card-wrapper {
            padding: 48px 20px;
        }
    }

    @@media (max-width: 575.98px) {
        .hero-title {
            font-size: 1.95rem;
        }
    }
</style>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="glow-bg glow-1"></div>
    <div class="glow-bg glow-2"></div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-content text-center text-lg-start">
                <h1 class="hero-title">@L["Home_HeroTitle"]</h1>
                <p class="hero-subtitle">
                    @L["Home_HeroDesc"]
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    @if (string.IsNullOrEmpty(token))
                    {
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-glow-premium">
                            @L["Home_CreateAccount"] <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-glass-premium">
                            @L["Auth_SignIn"]
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-glow-premium">
                            @L["Home_OpenDashboard"] <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    }
                </div>
                
                <div class="mt-5 d-flex align-items-center justify-content-center justify-content-lg-start gap-3">
                    <div class="d-flex text-warning">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="small" style="color: #94a3b8; font-weight: 500;">@L["Home_Trusted"]</span>
                </div>
            </div>

            <!-- MOCKUP -->
            <div class="col-lg-6 hero-mockup-container">
                <div class="hero-mockup-shadow">
                    <img src="~/images/mockup.png" alt="Spendly Platform Dashboard" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- BENEFITS SECTION -->
<section class="features-section">
    <div class="container text-center">
        <div class="mb-5 pb-3">
            <h2 class="fw-bold" style="font-family: var(--font-heading); font-size: 2.75rem; color: #ffffff; letter-spacing: -0.5px;">@L["Home_SmarterWealth"]</h2>
            <p style="font-size: 1.15rem; color: #94a3b8; max-width: 600px; margin: 0 auto; line-height: 1.6;">
                @L["Home_SmarterDesc"]
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <h4 class="mb-3">@L["Home_VisualAnalytics"]</h4>
                    <p class="mb-0">
                        @L["Home_VisualDesc"]
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h4 class="mb-3">@L["Home_PrecisionBudgets"]</h4>
                    <p class="mb-0">
                        @L["Home_PrecisionDesc"]
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h4 class="mb-3">@L["Home_Automation"]</h4>
                    <p class="mb-0">
                        @L["Home_AutomationDesc"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<section class="cta-section">
    <div class="container">
        <div class="glass-card-premium text-center cta-card-wrapper">
            <h2 class="fw-bold text-white mb-3" style="font-family: var(--font-heading); font-size: 2.5rem; letter-spacing: -0.5px;">@L["Home_CTA"]</h2>
            <p class="mb-4 fs-5" style="color: #cbd5e1; max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
                @L["Home_CTADesc"]
            </p>
            @if (string.IsNullOrEmpty(token))
            {
                <a asp-controller="Auth" asp-action="Register" class="btn btn-glow-premium btn-lg px-5">
                    @L["Home_StartJourney"] <i class="bi bi-arrow-right ms-2"></i>
                </a>
            }
            else
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-glow-premium btn-lg px-5">
                    @L["Home_OpenDashboard"] <i class="bi bi-arrow-right ms-2"></i>
                </a>
            }
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="dark-footer text-center">
    <div class="container">
        <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
            <i class="bi bi-wallet2 text-primary fs-4"></i>
            <h5 class="mb-0 tracking-widest">Spendly</h5>
        </div>
        <small style="color: #64748b;">
            © @DateTime.Now.Year Spendly Inc. @L["Home_Footer"]
        </small>
    </div>
</footer>

<script>
    // Handle bfcache (back-forward cache) to ensure accurate auth state on browser back
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
