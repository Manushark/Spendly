@{
    ViewData["Title"] = "Spendly - Smart Expense Tracking";
    var token = Context.Session.GetString("token");
}

<style>
    /* Premium Dark Theme Base */
    body {
        background-color: #080b11 !important;
        color: #ffffff;
        font-family: var(--font-body);
        overflow-x: hidden;
    }

    /* Navbar styling override */
    .navbar {
        background-color: transparent !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03) !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }
    .navbar-brand, .nav-link {
        color: #ffffff !important;
    }

    /* Hero Section */
    .hero-section {
        position: relative;
        padding: 160px 0 120px;
        overflow: hidden;
        background: radial-gradient(circle at 90% 10%, rgba(99, 102, 241, 0.12) 0%, rgba(8, 11, 17, 0) 60%),
                    radial-gradient(circle at 10% 90%, rgba(162, 155, 254, 0.08) 0%, rgba(8, 11, 17, 0) 60%);
    }

    /* Ambient Glow Effects */
    .glow-bg {
        position: absolute;
        border-radius: 50%;
        filter: blur(150px);
        opacity: 0.3;
        z-index: 1;
    }
    .glow-1 { top: 15%; right: 5%; width: 450px; height: 450px; background: var(--clr-primary); }
    .glow-2 { bottom: 10%; left: -5%; width: 350px; height: 350px; background: var(--clr-secondary); }

    .hero-content {
        position: relative;
        z-index: 3;
    }

    /* Animated text gradient */
    .hero-title {
        font-family: var(--font-heading);
        font-size: 4.25rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 24px;
        background: linear-gradient(135deg, #ffffff 10%, #a5b4fc 50%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -1.5px;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 44px;
        font-weight: 400;
        line-height: 1.65;
        max-width: 540px;
    }

    /* Smooth Floating Animation */
    @@keyframes floatingMockup {
        0% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-12px) rotate(0.3deg); }
        100% { transform: translateY(0px) rotate(0deg); }
    }

    .hero-mockup-container {
        position: relative;
        z-index: 3;
        animation: floatingMockup 6s ease-in-out infinite;
    }
    
    .hero-mockup-shadow {
        position: relative;
        border-radius: 24px;
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.65), 
                    0 0 100px rgba(99, 102, 241, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
    }
    .hero-mockup-shadow img {
        width: 100%;
        display: block;
        transition: transform 0.5s ease;
    }

    /* Premium Neon-Glow Buttons */
    .btn-glow-premium {
        background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        border-radius: 50px;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 24px rgba(99, 102, 241, 0.3);
    }
    .btn-glow-premium:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(99, 102, 241, 0.5);
        color: #ffffff;
    }

    .btn-glass-premium {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 50px;
        padding: 16px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-glass-premium:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        transform: translateY(-3px);
    }

    /* Benefits Section Glassmorphism */
    .features-section {
        padding: 120px 0;
        background-color: #080b11;
        position: relative;
    }

    .glass-card-premium {
        background: rgba(255, 255, 255, 0.01);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 24px;
        padding: 48px 36px;
        height: 100%;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .glass-card-premium:hover {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(99, 102, 241, 0.3);
        transform: translateY(-8px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 
                    inset 0 0 20px rgba(99, 102, 241, 0.05);
    }

    .feature-icon-premium {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(99, 102, 241, 0.05) 100%);
        color: var(--clr-primary-light);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 28px;
        border: 1px solid rgba(99, 102, 241, 0.2);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.1);
    }

    /* Footer styling */
    .dark-footer {
        background-color: #05070a;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        padding: 48px 0;
    }
</style>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="glow-bg glow-1"></div>
    <div class="glow-bg glow-2"></div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-content text-center text-lg-start">
                <h1 class="hero-title">@L["Home_HeroTitle"]</h1>
                <p class="hero-subtitle">
                    @L["Home_HeroDesc"]
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    @if (string.IsNullOrEmpty(token))
                    {
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-glow-premium">
                            @L["Home_CreateAccount"] <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-glass-premium">
                            @L["Auth_SignIn"]
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-glow-premium">
                            @L["Home_OpenDashboard"] <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    }
                </div>
                
                <div class="mt-5 d-flex align-items-center justify-content-center justify-content-lg-start gap-3 opacity-75">
                    <div class="d-flex text-warning">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="small text-muted">@L["Home_Trusted"]</span>
                </div>
            </div>

            <!-- MOCKUP -->
            <div class="col-lg-6 hero-mockup-container">
                <div class="hero-mockup-shadow">
                    <img src="~/images/mockup.png" alt="Spendly Platform Dashboard" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- BENEFITS SECTION -->
<section class="features-section">
    <div class="container text-center">
        <div class="mb-5 pb-3">
            <h2 class="fw-bold" style="font-family: var(--font-heading); font-size: 2.75rem; color: #ffffff; letter-spacing: -0.5px;">@L["Home_SmarterWealth"]</h2>
            <p class="text-muted" style="font-size: 1.15rem; max-width: 600px; margin: 0 auto;">
                @L["Home_SmarterDesc"]
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <h4 class="mb-3 fw-bold text-white" style="font-family: var(--font-heading);">@L["Home_VisualAnalytics"]</h4>
                    <p class="text-muted mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                        @L["Home_VisualDesc"]
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h4 class="mb-3 fw-bold text-white" style="font-family: var(--font-heading);">@L["Home_PrecisionBudgets"]</h4>
                    <p class="text-muted mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                        @L["Home_PrecisionDesc"]
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card-premium">
                    <div class="feature-icon-premium">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h4 class="mb-3 fw-bold text-white" style="font-family: var(--font-heading);">@L["Home_Automation"]</h4>
                    <p class="text-muted mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                        @L["Home_AutomationDesc"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<section class="py-5" style="background: linear-gradient(0deg, #05070a 0%, #080b11 100%);">
    <div class="container">
        <div class="glass-card-premium text-center" style="padding: 80px 20px; background: rgba(99, 102, 241, 0.02); border-color: rgba(99, 102, 241, 0.15);">
            <h2 class="fw-bold text-white mb-3" style="font-family: var(--font-heading); font-size: 2.5rem; letter-spacing: -0.5px;">@L["Home_CTA"]</h2>
            <p class="text-muted mb-4 fs-5" style="max-width: 600px; margin: 0 auto 32px;">
                @L["Home_CTADesc"]
            </p>
            @if (string.IsNullOrEmpty(token))
            {
                <a asp-controller="Auth" asp-action="Register" class="btn btn-glow-premium btn-lg px-5">
                    @L["Home_StartJourney"]
                </a>
            }
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="dark-footer text-center">
    <div class="container">
        <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
            <i class="bi bi-wallet2 text-primary fs-4"></i>
            <h5 class="mb-0 fw-bold text-white tracking-widest" style="font-family: var(--font-heading);">Spendly</h5>
        </div>
        <small class="text-muted">
            © @DateTime.Now.Year Spendly Inc. @L["Home_Footer"]
        </small>
    </div>
</footer>
