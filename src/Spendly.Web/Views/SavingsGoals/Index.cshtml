@model List<Spendly.Web.Contracts.SavingsGoals.SavingsGoalResponseDto>

@{
    ViewData["Title"] = L["Goals_Title"].Value;
    var active = Model.Where(g => !g.IsCompleted).ToList();
    var completed = Model.Where(g => g.IsCompleted).ToList();
    var totalSaved = Model.Sum(g => g.CurrentAmount);
    var totalTarget = Model.Sum(g => g.TargetAmount);
}

<style>
    .goals-progress-card {
        border-radius: 16px;
        border: 1px solid var(--clr-border);
        background: var(--clr-bg-card);
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }
    .goals-progress-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #10b981, #34d399);
    }

    .form-control-custom-sm {
        border-radius: 8px;
        font-size: 0.85rem;
        padding: 6px 12px;
        border: 1px solid var(--clr-border);
        background-color: var(--clr-surface-3);
        color: var(--clr-text);
        transition: all 0.2s ease;
    }
    .form-control-custom-sm:focus {
        background-color: var(--clr-surface);
        border-color: var(--clr-secondary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(var(--clr-primary-rgb), 0.15);
    }

    .modal-content-premium {
        background: var(--clr-surface);
        border-radius: 20px;
        border: 1px solid var(--clr-border);
    }

    /* ── Premium goal card ─────────────────────────────────────────── */
    .goal-card-active {
        border-radius: 18px;
        border: 1px solid var(--clr-border);
        background: var(--clr-bg-card);
        position: relative;
        overflow: hidden;
        transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.28s ease,
                    border-color 0.28s ease;
    }
    .goal-card-active:hover {
        transform: translateY(-6px) scale(1.01);
        border-color: color-mix(in srgb, var(--goal-color, #6366f1) 60%, transparent);
        box-shadow: 0 20px 40px -8px color-mix(in srgb, var(--goal-color, #6366f1) 25%, transparent),
                    0 4px 16px -4px rgba(0,0,0,0.3);
    }

    /* Gradient animated progress bar */
    .goal-progress-track {
        height: 10px;
        border-radius: 10px;
        background: var(--clr-surface-3);
        overflow: hidden;
    }
    .goal-progress-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg,
            color-mix(in srgb, var(--goal-color, #6366f1) 70%, #ffffff),
            var(--goal-color, #6366f1),
            color-mix(in srgb, var(--goal-color, #6366f1) 70%, #ffffff));
        background-size: 200% 100%;
        animation: progressShimmer 2.5s ease-in-out infinite,
                   progressGrow 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        transform-origin: left center;
    }
    @@keyframes progressShimmer {
        0%   { background-position: 200% center; }
        100% { background-position: -200% center; }
    }
    @@keyframes progressGrow {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
    }

    /* Overall progress */
    .overall-progress-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #10b981, #34d399, #10b981);
        background-size: 200% 100%;
        animation: progressShimmer 3s ease-in-out infinite,
                   progressGrow 1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        transform-origin: left center;
    }

    /* Amount counter */
    .goal-amount-main {
        font-size: 1.2rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        animation: fadeUp 0.6s ease both;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Icon bubble */
    .goal-icon-bubble {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.3rem;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .goal-card-active:hover .goal-icon-bubble {
        transform: scale(1.15) rotate(-5deg);
    }

    /* Add funds button */
    .btn-add-funds {
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 7px 16px;
        border: 1.5px solid;
        background: transparent;
        transition: all 0.22s ease;
        letter-spacing: 0.2px;
        cursor: pointer;
    }
    .btn-add-funds:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px color-mix(in srgb, var(--goal-color, #6366f1) 30%, transparent);
    }

    /* Staggered card animation */
    .goal-card-wrapper {
        animation: fadeUp 0.5s ease both;
    }
    .goal-card-wrapper:nth-child(1) { animation-delay: 0.05s; }
    .goal-card-wrapper:nth-child(2) { animation-delay: 0.10s; }
    .goal-card-wrapper:nth-child(3) { animation-delay: 0.15s; }
    .goal-card-wrapper:nth-child(4) { animation-delay: 0.20s; }
    .goal-card-wrapper:nth-child(5) { animation-delay: 0.25s; }
    .goal-card-wrapper:nth-child(6) { animation-delay: 0.30s; }

    /* Completed card */
    .goal-card-premium {
        border-radius: 16px;
        border: 1px solid var(--clr-border);
        background: var(--clr-bg-card);
        box-shadow: var(--shadow-sm);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        overflow: hidden;
    }
    .goal-card-premium:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1" style="font-family:'Calistoga',serif; letter-spacing:-0.5px;">
                <i class="bi bi-trophy text-warning me-2"></i>@L["Goals_Title"]
                <button class="help-trigger" data-help-trigger data-help-title="@L["Help_Goals_Title"]" data-help-body="@L["Help_Goals_Body"]" data-help-icon="bi-trophy" title="Ayuda / Help">?</button>
            </h2>
            <small class="text-muted">@L["Goals_ManageSubtitle"]</small>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#createGoalModal">
            <i class="bi bi-plus-lg me-1"></i> @L["Goals_NewGoal"]
        </button>
    </div>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius:12px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Overall Progress & KPI Summary -->
    @if (Model.Any())
    {
        @* ─── KPI Summary Cards (2x2 on Mobile, 4-col on Desktop) ──────── *@
        <div class="row g-2 g-md-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="kpi-card h-100 p-3 p-md-4">
                    <div class="kpi-accent kpi-accent-green"></div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pt-1">
                        <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing:.5px;">@L["Goals_OverallProgress"]</span>
                        <div class="kpi-icon kpi-icon-green"><i class="bi bi-wallet2"></i></div>
                    </div>
                    <h2 class="kpi-value fw-bold font-mono mb-1 text-success">
                        $@totalSaved.ToString("N2")
                    </h2>
                    <small class="text-muted">@L["Goals_ActiveLower"]</small>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="kpi-card h-100 p-3 p-md-4">
                    <div class="kpi-accent kpi-accent-blue"></div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pt-1">
                        <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing:.5px;">@L["Goals_Title"]</span>
                        <div class="kpi-icon kpi-icon-blue"><i class="bi bi-bullseye"></i></div>
                    </div>
                    <h2 class="kpi-value fw-bold font-mono mb-1 text-primary">
                        $@totalTarget.ToString("N2")
                    </h2>
                    <small class="text-muted">@Model.Count @L["Goals_Title"]</small>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="kpi-card h-100 p-3 p-md-4">
                    <div class="kpi-accent kpi-accent-violet"></div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pt-1">
                        <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing:.5px;">@L["Goals_ActiveGoals"]</span>
                        <div class="kpi-icon kpi-icon-violet"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                    <h2 class="kpi-value fw-bold font-mono mb-1 text-primary">
                        @active.Count
                    </h2>
                    <small class="text-muted">@active.Count @L["Goals_ActiveLower"]</small>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="kpi-card h-100 p-3 p-md-4">
                    <div class="kpi-accent kpi-accent-green"></div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pt-1">
                        <span class="text-muted fw-semibold small text-uppercase" style="letter-spacing:.5px;">@L["Goals_Completed"]</span>
                        <div class="kpi-icon kpi-icon-green"><i class="bi bi-check-circle"></i></div>
                    </div>
                    <h2 class="kpi-value fw-bold font-mono mb-1 text-success">
                        @completed.Count
                    </h2>
                    <small class="text-muted">@L["Goals_Achieved"]</small>
                </div>
            </div>
        </div>

        <div class="card goals-progress-card border-0 mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold" style="font-family:'Calistoga',serif; font-size:1.1rem;">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i>@L["Goals_OverallProgress"]
                    </span>
                    <span class="font-mono fw-bold text-muted" style="font-size:0.95rem;">
                        $@totalSaved.ToString("N2") / $@totalTarget.ToString("N2")
                    </span>
                </div>
                <div class="goal-progress-track">
                    @{
                        var overallPct = totalTarget > 0 ? Math.Min(100, (totalSaved / totalTarget) * 100) : 0;
                    }
                    <div class="overall-progress-fill" style="width: @overallPct.ToString(System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                </div>
                <small class="text-muted mt-2 d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    @active.Count @L["Goals_ActiveLower"] · @completed.Count @L["Goals_CompletedLower"]
                </small>
            </div>
        </div>
    }

    <!-- Active Goals -->
    @if (active.Any())
    {
        <h5 class="fw-bold mb-3" style="font-family:'Calistoga',serif; letter-spacing:-0.2px;">
            <i class="bi bi-bullseye text-primary me-2"></i>@L["Goals_ActiveGoals"]
        </h5>
        <div class="row g-2 g-md-3 mb-4">
            @foreach (var goal in active)
            {
                <div class="col-md-6 col-lg-4 goal-card-wrapper">
                    <div class="goal-card-active h-100" style="--goal-color: @goal.Color; border-left: 4px solid @goal.Color !important;">
                        <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="goal-icon-bubble"
                                             style="background: color-mix(in srgb, @goal.Color 15%, transparent); border: 1px solid color-mix(in srgb, @goal.Color 30%, transparent);">
                                            <i class="bi @goal.Icon" style="color:@goal.Color;"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                            <h6 class="mb-0 fw-bold text-truncate" style="font-family:'Calistoga',serif;">@goal.Name</h6>
                                            @if (goal.Deadline.HasValue)
                                            {
                                                var daysLeft = (goal.Deadline.Value - DateTime.UtcNow).Days;
                                                <small class="text-muted text-truncate d-block mt-0.5" style="font-size:0.75rem;">
                                                    <i class="bi bi-clock me-1"></i>
                                                    @if (daysLeft > 0)
                                                    {
                                                        <span>@daysLeft @L["Goals_DaysLeft"]</span>
                                                    }
                                                    else if (daysLeft == 0)
                                                    {
                                                        <span class="text-warning fw-semibold">@L["Time_JustNow"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger fw-semibold">@L["Bud_OverBudgetAmount"]</span>
                                                    }
                                                </small>
                                            }
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-link btn-sm text-muted p-0" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@goal.Id">
                                                    <i class="bi bi-pencil me-2"></i>@L["Common_Edit"]
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@goal.Id" method="post"
                                                      onsubmit="return confirm('@L["Goal_DeleteConfirm"].Value');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="dropdown-item text-danger" type="submit">
                                                        <i class="bi bi-trash me-2"></i>@L["Common_Delete"]
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- Amounts + Gradient Progress Bar -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                                        <span class="goal-amount-main" style="color:@goal.Color;">
                                            $@goal.CurrentAmount.ToString("N2")
                                        </span>
                                        <span class="text-muted font-mono" style="font-size:0.88rem;">
                                            of $@goal.TargetAmount.ToString("N2")
                                        </span>
                                    </div>
                                    <div class="goal-progress-track mb-1">
                                        <div class="goal-progress-fill"
                                             style="width: @goal.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%;
                                                    --goal-color: @goal.Color;">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <small class="text-muted font-mono" style="font-size:0.75rem;">
                                            @goal.ProgressPercentage.ToString("N1")% @L["Goals_Complete"]
                                        </small>
                                        @if (goal.ProgressPercentage >= 75)
                                        {
                                            <small class="fw-semibold" style="font-size:0.72rem; color: @goal.Color;">
                                                <i class="bi bi-fire me-1"></i>Almost there!
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Add Funds Form -->
                            <form asp-action="AddFunds" asp-route-id="@goal.Id" method="post"
                                  class="d-flex gap-2 mt-2 pt-3"
                                  style="border-top: 1px solid color-mix(in srgb, @goal.Color 20%, var(--clr-border));">
                                @Html.AntiForgeryToken()
                                <div class="input-group input-group-sm flex-grow-1">
                                    <span class="input-group-text bg-transparent px-2 text-muted"
                                          style="border-color: color-mix(in srgb, @goal.Color 40%, var(--clr-border)); border-right: none;">$</span>
                                    <input type="number" name="amount" step="0.01" min="0.01"
                                           placeholder="@L["Ph_Amount"]"
                                           class="form-control form-control-custom-sm font-mono"
                                           style="border-color: color-mix(in srgb, @goal.Color 40%, var(--clr-border)); border-left: none; border-radius: 0 8px 8px 0;"
                                           required>
                                </div>
                                <button type="submit" class="btn-add-funds"
                                        style="background: color-mix(in srgb, @goal.Color 12%, transparent);
                                               border-color: color-mix(in srgb, @goal.Color 50%, transparent);
                                               color: @goal.Color;
                                               --goal-color: @goal.Color;">
                                    <i class="bi bi-plus-circle me-1"></i>@L["Goal_AddFunds"]
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Completed Goals -->
    @if (completed.Any())
    {
        <h5 class="fw-bold mb-3 mt-4" style="font-family:'Calistoga',serif; letter-spacing:-0.2px;">
            <i class="bi bi-check-circle text-success me-2"></i>@L["Goals_Completed"]
        </h5>
        <div class="row g-2 g-md-3 mb-4">
            @foreach (var goal in completed)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card goal-card-premium h-100 opacity-75" style="border-left: 4px solid #10b981 !important;">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success bg-opacity-10"
                                         style="width:40px; height:40px; flex-shrink: 0;">
                                        <i class="bi bi-trophy-fill text-success fs-5"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <h6 class="mb-0 fw-bold text-decoration-line-through text-truncate" style="font-family:'Calistoga',serif;">@goal.Name</h6>
                                        <small class="text-success fw-semibold font-mono d-block mt-0.5">
                                            $@goal.TargetAmount.ToString("N2") @L["Goals_Achieved"]
                                        </small>
                                    </div>
                                </div>
                                <form asp-action="Delete" asp-route-id="@goal.Id" method="post"
                                      onsubmit="return confirm('@L["Goal_DeleteConfirm"].Value');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-link btn-sm text-danger p-0 rounded-circle" type="submit" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; background: rgba(239, 68, 68, 0.05);">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="card goal-card-premium border-0 py-5 mt-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-trophy display-1 text-muted d-block mb-3 opacity-30"></i>
                <h3 class="mb-3" style="font-family:'Calistoga',serif;">@L["Goals_NoGoals"]</h3>
                <p class="text-muted mb-4">@L["Goals_StartPlanning"]</p>
                <button class="btn btn-primary rounded-pill px-5 btn-lg fw-semibold" data-bs-toggle="modal" data-bs-target="#createGoalModal">
                    <i class="bi bi-plus-lg me-1"></i> @L["Goals_NewGoal"]
                </button>
            </div>
        </div>
    }
</div>

<!-- Create Goal Modal -->
<div class="modal fade" id="createGoalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-premium border-0 shadow-lg">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" style="font-family:'Calistoga',serif;">
                        <i class="bi bi-trophy me-2 text-warning"></i>@L["Goals_NewGoal"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Common_Name"]</label>
                        <input type="text" name="Name" class="form-control rounded-3" placeholder="@L["Ph_GoalName"]" required maxlength="100" style="padding: 10px 14px;">
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Goal_TargetAmount"]</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:var(--clr-surface-3); border-color:var(--clr-border);">$</span>
                                <input type="number" name="TargetAmount" class="form-control rounded-end-3 font-mono" step="0.01" min="1" required style="padding: 10px 14px;">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Goal_AlreadySaved"]</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:var(--clr-surface-3); border-color:var(--clr-border);">$</span>
                                <input type="number" name="CurrentAmount" class="form-control rounded-end-3 font-mono" step="0.01" min="0" value="0" style="padding: 10px 14px;">
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Goal_Deadline"] (@L["Common_Optional"])</label>
                        <input type="date" name="Deadline" class="form-control rounded-3" style="padding: 10px 14px;">
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Common_Icon"]</label>
                            <select name="Icon" class="form-select rounded-3" style="padding: 10px 14px;">
                                <option value="bi-bullseye">🎯 @L["Goal_IconTarget"]</option>
                                <option value="bi-airplane">✈️ @L["Goal_IconTravel"]</option>
                                <option value="bi-house">🏠 @L["Goal_IconHome"]</option>
                                <option value="bi-car-front">🚗 @L["Goal_IconCar"]</option>
                                <option value="bi-mortarboard">🎓 @L["Goal_IconEducation"]</option>
                                <option value="bi-heart">❤️ @L["Goal_IconHealth"]</option>
                                <option value="bi-gift">🎁 @L["Goal_IconGift"]</option>
                                <option value="bi-laptop">💻 @L["Goal_IconTech"]</option>
                                <option value="bi-piggy-bank">🐷 @L["Goal_IconSavings"]</option>
                                <option value="bi-shield-check">🛡️ @L["Goal_IconEmergency"]</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing:0.5px;">@L["Common_Color"]</label>
                            <input type="color" name="Color" class="form-control form-control-color w-100 rounded-3" value="#6366f1" style="height: 43px; padding: 6px;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">@L["Common_Cancel"]</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i>@L["Common_Create"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
